{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the Synapse main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:app:default",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "deep-link:default",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
